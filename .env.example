# Server
NODE_ENV=development
PORT=3000

# Security (REQUIRED in production: >= 16 random characters)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

# CORS (comma-separated allowed frontend origins in production, e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Reverse proxy hops for accurate rate-limit IP resolution (default: 1 in production)
# TRUST_PROXY=1

# Database (MongoDB)
# - On Railway MongoDB: set MONGO_URL=${{MongoDB.MONGO_URL}} or MONGODB_URI=${{MongoDB.MONGO_URL}}
# - Local development fallback: mongodb://127.0.0.1:27017/factory_mng
MONGODB_URI=mongodb://127.0.0.1:27017/factory_mng

# Bootstrap demo seed controls
# ENABLE_DEMO_SEED=true
# SEED_DEFAULT_PASSWORD=replace-with-initial-admin-password-min-8-chars
