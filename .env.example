# Server
NODE_ENV=development
PORT=3000

# Security (REQUIRED in production: >= 16 random characters)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

# CORS (comma-separated allowed frontend origins in production, e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Database
# - On Railway PostgreSQL: set DATABASE_URL=${{Postgres.DATABASE_URL}} (or DB_TYPE=postgres + DB_* vars)
# - Local development fallback: DB_TYPE=sqlite uses sql.js file DB_NAME
DB_TYPE=sqlite
DB_NAME=db.sqlite

# PostgreSQL connection options (used when DB_TYPE=postgres or DATABASE_URL is set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factory_mng
# DB_SSL=false
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=factory_mng
